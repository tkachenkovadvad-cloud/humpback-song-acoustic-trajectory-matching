license: "Apache-2.0"

version: "1.0.0"

date-released: "2026-09-12"

keywords:
  - "humpback whale"
  - "whale song"
  - "bioacoustics"
  - "acoustic trajectory"
  - "acoustic matching"
  - "machine-assisted analysis"
  - "sequence reconstruction"